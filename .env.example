# Discourse Configuration (no trailing slash)
VITE_DISCOURSE_URL=https://forum.yourcommunity.org
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=CAC Forms

# Discourse group name for verified users (Admin > Groups)
VITE_VERIFIED_GROUP_NAME=verified-members

# Discourse custom user field IDs (Admin > Customize > User Fields)
VITE_PHONE_FIELD_ID=2
VITE_EMERGENCY_CONTACT_FIELD_ID=3
VITE_BLOOD_GROUP_FIELD_ID=4
VITE_AGE_GROUP_FIELD_ID=5

# Google Sheets — preferred: direct Sheets API (no Apps Script cold start)
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-the-url
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Or split credentials:
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Share the spreadsheet with the service account email (Editor).

# Set to true to call Discourse on every registration API request (slower; default trusts client discourseUser).
# VERIFY_DISCOURSE_ON_REGISTRATION=false

# Upstash Redis — provisioned via Vercel Marketplace (copies all vars below into the project)
#
# Used by this app (@upstash/redis HTTP client in server/lib/redis/client.ts):
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-rest-token
#
# Also set by Vercel but not read by this codebase:
# KV_REST_API_READ_ONLY_TOKEN=...   # read-only; we need writes for locks/cache
# KV_URL=rediss://...               # native Redis TCP; we use REST, not ioredis
# REDIS_URL=rediss://...            # alias of KV_URL for some tools

# Google Form for non-members signup (optional)
VITE_GOOGLE_FORM_URL=https://forms.google.com/your-form-here
