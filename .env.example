# Discourse Configuration (no trailing slash)
VITE_DISCOURSE_URL=https://forum.yourcommunity.org
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=CAC Forms

# Discourse group name for verified users (Admin > Groups)
VITE_VERIFIED_GROUP_NAME=verified-members

# Discourse custom user field IDs (Admin > Customize > User Fields)
VITE_PHONE_FIELD_ID=2
VITE_EMERGENCY_CONTACT_FIELD_ID=3
VITE_BLOOD_GROUP_FIELD_ID=4
VITE_AGE_GROUP_FIELD_ID=5

# Google Sheets API (server-only)
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-the-url
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Or split credentials:
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Share the spreadsheet with the service account email (Editor).
#
# Optional: tab name for the global registration denylist (default: Blacklist).
# Create a tab with headers Email, Phone, Username (any subset per row). Matching is
# case-insensitive email, last-10 phone digits, and lowercase Discourse username.
# Cached in Redis for 6 hours. If the tab is missing, registration is allowed.
# BLACKLIST_SHEET_TAB=Blacklist

# Verify Discourse identity on registration API requests. Defaults to on (fail-closed).
# Set to false only for local Sheets testing without a live Discourse session.
VERIFY_DISCOURSE_ON_REGISTRATION=true

# Upstash Redis — provisioned via Vercel Marketplace (copies all vars below into the project)
#
# Used by this app (@upstash/redis HTTP client in server/lib/redis/client.ts):
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-rest-token
#
# Also set by Vercel but not read by this codebase:
# KV_REST_API_READ_ONLY_TOKEN=...   # read-only; we need writes for locks/cache
# KV_URL=rediss://...               # native Redis TCP; we use REST, not ioredis
# REDIS_URL=rediss://...            # alias of KV_URL for some tools

# Google Form for non-members signup (optional)
VITE_GOOGLE_FORM_URL=https://forms.google.com/your-form-here

# Sentry (optional — skipped when DSN is unset)
# Create a project at https://sentry.io then set these on Vercel (Production + Preview).
# VITE_SENTRY_DSN is public and baked into the client bundle at build time.
# SENTRY_DSN is server-only (Vercel API routes). Same project is fine, or use a Node project.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source-map upload during `vite build` (keep the auth token secret):
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# Server-only: emails/phones allowed to register when a form is closed or full.
# Never commit real values. JSON keyed by formId.
# Only form IDs listed in WHITELIST_REGISTRATION_FORM_IDS (server/lib/sheets/config.ts)
# and FormConfig.allowsRegistrationWhitelist are honored — currently perseids-2026.
# REGISTRATION_WHITELISTS={"perseids-2026":{"emails":["person@test.com"],"phones":["9xxxxxxx"]}}
#
# Calendar invites (Resend). Server-only — never prefix with VITE_.
# Verify chennaiastronomyclub.org in Resend. From/reply-to have defaults:
#   From: Chennai Astronomy Club <no-reply@chennaiastronomyclub.org>
#   Reply-To: hello@chennaiastronomyclub.org
# RESEND_API_KEY=re_...
# Optional overrides:
# CALENDAR_FROM_EMAIL=Chennai Astronomy Club <no-reply@chennaiastronomyclub.org>
# CALENDAR_REPLY_TO=hello@chennaiastronomyclub.org

# Shareable invite links (no forum login required) — put the recipient's email and/or phone in the URL:
#   /form/perseids-2026?email=person%40test.com
#   /form/perseids-2026?phone=9xxxxxxxx
#   /form/perseids-2026?email=person%40test.com&phone=9xxxxxxxx
# Note: knowing a whitelisted phone/email is enough to open the invite (treat the link as a secret).
